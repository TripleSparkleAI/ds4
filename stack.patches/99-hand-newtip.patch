-    if (cached < 0) { const char *e = getenv("DS4_CUDA_HITS_FIRST"); cached = !(e && e[0] == '0'); }
+    /* OFF by default in the stacked tree.  This lever measured a NULL solo, and
+     * the reason is structural rather than a bad implementation: the decode
